[Unit]
Description=Publish host metrics to Home Assistant via MQTT
Documentation=https://github.com/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=host-metrics
Group=host-metrics
# vcgencmd fallback on a Raspberry Pi needs the video group.
SupplementaryGroups=video

# The config stays root-only on disk. Before each start systemd copies it - as
# root, that is the "+" - into a runtime directory only the service user can read.
# (Not LoadCredential=: systemd 247 on Debian 11 fails with it.)
RuntimeDirectory=host-metrics-mqtt
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/bin/install -m 0600 -o host-metrics -g host-metrics /etc/host-metrics-mqtt/config.yaml /run/host-metrics-mqtt/config.yaml
ExecStart=/usr/bin/python3 /opt/host-metrics-mqtt/host-metrics-mqtt.py --config /run/host-metrics-mqtt/config.yaml
Environment=PYTHONUNBUFFERED=1

Restart=always
RestartSec=10

# Hardening. No ProtectSystem= on purpose: it would make "/" read-only inside the
# service namespace and break the read-only filesystem detection.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=yes
LockPersonality=yes
MemoryMax=96M

[Install]
WantedBy=multi-user.target
